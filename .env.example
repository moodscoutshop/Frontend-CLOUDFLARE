# ─────────────────────────────────────────────────────────────────────────────
# MoodScout Landing — Environment Variables
#
# Copy this file to .env for local development.
# Set these in Cloudflare Pages → Settings → Environment Variables for production.
#
# All variables MUST be prefixed with REACT_APP_ so that Create React App
# bakes them into the static JS bundle at build time.
# ─────────────────────────────────────────────────────────────────────────────

# ── REQUIRED ─────────────────────────────────────────────────────────────────

# Backend API base URL (no trailing slash).
# Production: https://api.moodscout.shop  (or your deployed backend URL)
# Local dev:  http://localhost:5000
REACT_APP_API_URL=http://localhost:5000

# ── OPTIONAL (have safe built-in fallbacks) ───────────────────────────────────

# Enable verbose console logging in the browser.
# Set to 'true' only for debugging. Leave 'false' in production.
REACT_APP_DEBUG_MODE=false

# Google Analytics Measurement ID.
# Falls back to a hardcoded ID in analytics.js if not set.
REACT_APP_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Stripe Publishable Key.
# Only needed if Stripe payment UI is active in this frontend.
# Get from: https://dashboard.stripe.com/apikeys
REACT_APP_STRIPE_PUBLISHABLE_KEY=pk_live_...
